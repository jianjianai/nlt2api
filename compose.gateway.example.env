# compose.gateway.yaml（仅转发服务）的环境变量示例。
# 复制为 .env 后填写：  cp compose.gateway.example.env .env
# 然后：docker compose -f compose.gateway.yaml up -d
# （.env 位于 compose 文件同目录，即仓库根目录）

# ---- 密钥（不可为空）----
# 管理后台与 /api/admin 的凭据。
GATEWAY_ADMIN_TOKEN=
# 客户端调用 /v1/* 的 Bearer 密钥。
GATEWAY_API_KEY=
# 授权服务接入 /ws/minter 的共享密钥（将来接 minter 时保持一致）。
MINTER_TOKEN=

# ---- 可选 ----
# 显式开启后 /v1 允许匿名访问。除内网自用外不要打开。
GATEWAY_ALLOW_ANONYMOUS=false
# 上游 Turnstile site key；一般无需设置，使用内置默认值。
# GATEWAY_TURNSTILE_SITEKEY=
# gateway 对外映射端口（默认 3000）。
# GATEWAY_HOST_PORT=3000