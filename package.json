{
  "name": "neuralwatt-ai",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "ui:compile": "tsx scripts/compile-admin-ui.ts",
    "ui:check": "tsx scripts/compile-admin-ui.ts --check",
    "prebuild": "pnpm run ui:compile",
    "build": "nitro build",
    "predev": "pnpm run ui:compile",
    "dev": "nitro dev",
    "preview": "node .output/server/index.mjs",
    "test": "pnpm run ui:check && tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "data:migrate-v2": "tsx scripts/migrate-v2.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vue/compiler-dom": "3.5.41",
    "h3": "^1.15.4",
    "nitropack": "^2.12.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vue": "3.5.41"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "lucide": "^1.31.0",
    "yaml": "^2.9.0"
  }
}
