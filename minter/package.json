{
  "name": "nlt-minter",
  "version": "1.1.4",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12 <23"
  },
  "type": "module",
  "scripts": {
    "start": "node --experimental-transform-types src/main.ts",
    "dev": "node --experimental-transform-types --watch src/main.ts",
    "test": "node --experimental-transform-types --import ./tests/register-alias.mjs --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
