# 授权服务（minter）配置示例。复制为 .env 后填写。
# 授权服务没有管理后台，全部行为由这些环境变量与转发服务下发的指令决定。

# ---- 必填 ----
# 转发服务地址，自动推导为 <scheme>://host/ws/minter。
GATEWAY_URL=http://127.0.0.1:3000
# 与转发服务一致的共享密钥。
MINTER_TOKEN=

# ---- 身份与并发 ----
# 稳定标识，重连后沿用同一会话身份；缺省为 hostname-<随机>。
# MINTER_AGENT_ID=
# 后台展示名，缺省为 hostname。
# MINTER_LABEL=
# 同时进行的铸票数。每个并发占一个常驻浏览器，约 1.6 GB 内存。
MINTER_CONCURRENCY=1

# ---- 浏览器 ----
# 留空则按平台自动探测（Windows: Edge/Chrome；Linux: Chrome/Chromium）。
# 注意：配置了不存在的路径会被忽略并回退到自动探测。
# Linux 生产环境：
# MINTER_BROWSER_PATH=/usr/bin/chromium
# 浏览器 profile 目录，必须在工程目录之外（Chromium 会持续改写锁文件）。
# MINTER_PROFILE_DIR=/app/.data/profile
# Linux 虚拟显示：挑战拒绝 headless，必须有真实渲染管线（Xvfb）。
# MINTER_DISPLAY=:99
# CDP 起始端口，第 n 个实例使用 basePort + n。
# MINTER_BASE_PORT=9333

# ---- 铸票 ----
# 兜底 site key；转发服务会在 welcome 帧中下发权威值并覆盖它。
# MINTER_SITEKEY=0x4AAAAAADlBNBTRb73O02Vo
# 单次铸票超时（毫秒）。
# MINTER_MINT_TIMEOUT_MS=60000
# 空闲多久回收浏览器（毫秒），0 表示常驻。
# MINTER_IDLE_RELEASE_MS=600000
