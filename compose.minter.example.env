# compose.minter.yaml（仅授权服务）的环境变量示例。
# 复制为 .env 后填写：  cp compose.minter.example.env .env
# 然后：docker compose -f compose.minter.yaml up -d
# （.env 位于 compose 文件同目录，即仓库根目录）

# ---- 必填 ----
# 转发服务地址（容器内网络用 http://gateway:3000，跨机用实际地址）。
GATEWAY_URL=
# 与转发服务一致的共享密钥。
MINTER_TOKEN=

# ---- 可选 ----
# 并发铸票数（每 +1 约需 1.6 GB 内存）。
# MINTER_CONCURRENCY=1
# 后台展示名。
# MINTER_LABEL=compose
# 副本数（横向扩容）。
# MINTER_REPLICAS=1