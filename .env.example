# Required: protects the management API and browser panel.
DEEPINFRA_GATEWAY_ADMIN_TOKEN=replace-with-a-separate-long-random-secret

# Required by default: bearer/x-api-key accepted by the OpenAI-compatible API.
# Set ALLOW_ANONYMOUS=true only for an isolated local smoke test.
DEEPINFRA_GATEWAY_API_KEY=replace-with-a-client-secret
DEEPINFRA_GATEWAY_ALLOW_ANONYMOUS=false

# Gateway state and default model.
DEEPINFRA_GATEWAY_DATA_DIR=./.data/deepinfra
DEEPINFRA_GATEWAY_DEFAULT_MODEL=moonshotai/Kimi-K3

# Chrome/Xvfb settings for the anonymous DeepInfra Turnstile minter.
DEEPINFRA_BROWSER_PATH=/usr/bin/google-chrome-stable
DEEPINFRA_DISPLAY=:99
DEEPINFRA_PROFILE_DIR=/tmp/deepinfra-gateway-profile
DEEPINFRA_TURNSTILE_MINTERS=2
DEEPINFRA_TURNSTILE_BASE_PORT=9333

# Request, response and upstream limits.
DEEPINFRA_GATEWAY_MAX_REQUEST_BYTES=67108864
DEEPINFRA_GATEWAY_MAX_OUTPUT_TOKENS=128000
DEEPINFRA_GATEWAY_MIN_OUTPUT_TOKENS=8192
DEEPINFRA_GATEWAY_MAX_UPSTREAM_BYTES=16777216
DEEPINFRA_GATEWAY_MAX_RESPONSE_HISTORY_BYTES=16777216
DEEPINFRA_GATEWAY_MAX_RESPONSE_ITEMS=10000
DEEPINFRA_GATEWAY_MAX_CHAT_MESSAGES=10000
DEEPINFRA_GATEWAY_MAX_RESPONSE_STATE_BYTES=16777216
# Inactivity timeout for response headers and consecutive upstream chunks.
DEEPINFRA_GATEWAY_UPSTREAM_TIMEOUT_MS=120000
