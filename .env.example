# Required to use the local management API and browser panel.
NEURALWATT_ADMIN_TOKEN=replace-with-a-separate-long-random-secret

# Optional: require this bearer token from OpenAI-compatible clients.
# This is required by default. Set NEURALWATT_ALLOW_ANONYMOUS=true only for a
# deliberately isolated local smoke test.
NEURALWATT_API_KEY=replace-with-a-client-secret
NEURALWATT_ALLOW_ANONYMOUS=false

# Optional deployment tuning.
NEURALWATT_DATA_DIR=./.data/neuralwatt
NEURALWATT_DEFAULT_MODEL=kimi-k3-fast
NEURALWATT_MAX_RECORD_BYTES=5242880
NEURALWATT_MAX_REQUEST_BYTES=8388608
# Optional fallback ceiling for the default output budget. Client requests no
# longer enforce an upper limit; this only bounds the default used when a
# request omits max_tokens/max_completion_tokens.
NEURALWATT_MAX_OUTPUT_TOKENS=128000
NEURALWATT_MAX_UPSTREAM_BYTES=16777216
# Responses API state: per-chain reconstructed history cap and total on-disk
# cap for stored `previous_response_id` chains.
NEURALWATT_MAX_RESPONSE_HISTORY_BYTES=2097152
NEURALWATT_MAX_RESPONSE_STATE_BYTES=16777216
# Maximum time to wait for response headers or for the next upstream response
# chunk. Active SSE streams reset this inactivity timeout whenever data arrives.
NEURALWATT_UPSTREAM_TIMEOUT_MS=120000
