# 转发服务（gateway）配置示例。复制为 .env 后填写。

# ---- 密钥（三者独立，均不可为空）----
# 管理后台与 /api/admin 的凭据。未配置时管理接口一律返回 503。
GATEWAY_ADMIN_TOKEN=
# 客户端调用 /v1/* 的 Bearer 密钥。未配置时 /v1 一律拒绝。
GATEWAY_API_KEY=
# 授权服务接入 /ws/minter 的共享密钥。未配置时该端点一律 401。
MINTER_TOKEN=

# 显式开启后 /v1 允许匿名访问。除内网自用外不要打开。
GATEWAY_ALLOW_ANONYMOUS=false

# ---- 存储 ----
GATEWAY_DATA_DIR=.data/gateway

# ---- 上游 ----
# Turnstile site key，通过 welcome 帧下发给所有授权服务；上游更换时只改这里。
# GATEWAY_TURNSTILE_SITEKEY=0x4AAAAAADlBNBTRb73O02Vo

# ---- 请求体上限（字节）----
# GATEWAY_MAX_REQUEST_BYTES=67108864
# GATEWAY_MAX_UPSTREAM_BYTES=16777216
# GATEWAY_MAX_IMPORT_BYTES=16777216
